    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "corestore": "^7.9.1",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.0",
    "pear-runtime": "^1.0.1",
    "radix-ui": "^1.4.3",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "which-runtime": "^1.3.2"
