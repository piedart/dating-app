  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "lint": "prettier --check . && lunte electron workers src scripts vite.config.mjs forge.config.js",
    "format": "prettier --write . && lunte --fix electron workers src scripts vite.config.mjs forge.config.js",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "start": "node scripts/electron-start.cjs",
    "start:hmr": "node scripts/electron-dev.cjs",
    "package": "npm run build:renderer && electron-forge package",
    "make:darwin": "npm run build:renderer && electron-forge make --platform=darwin",
    "make:win32": "npm run build:renderer && electron-forge make --platform=win32",
    "make:linux": "npm run build:renderer && electron-forge package && ./scripts/build-app-image.sh"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
